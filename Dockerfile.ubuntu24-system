# ==============================================================================
# Belt Control System - Ubuntu 24.04 System Layer
# ✅ 2026-02-25 15:40 [Phase 7.47.3]: 分层镜像方案 - 第一层
# 用途：只包含 apt-get 系统包，很少变化
# 构建：docker build -t belt-control-system:latest -f Dockerfile.ubuntu24-system .
# ==============================================================================

FROM --platform=linux/arm64 ubuntu:24.04

# Avoid interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# ============================================================
# Install ALL system dependencies via apt-get
# This layer is CACHED and will NOT be rebuilt unless changed
# ============================================================
RUN apt-get update && apt-get install -y \
    # Core libraries
    libc6 \
    libstdc++6 \
    libgcc-s1 \
    \
    # Audio and multimedia
    libasound2t64 \
    libopus0 \
    libsdl2-2.0-0 \
    \
    # Video/Audio codecs (FFmpeg dependencies from device)
    libvpx9 \
    libx264-164 \
    libx265-199 \
    libmp3lame0 \
    libspeex1 \
    libtheora0 \
    libvorbis0a \
    libvorbisenc2 \
    libogg0 \
    libyuv0 \
    \
    # Video4Linux
    libv4l-0t64 \
    \
    # OpenGL/EGL/Graphics
    libegl1 \
    libgles2 \
    libgbm1 \
    libdrm2 \
    libwayland-client0 \
    libwayland-egl1 \
    libwayland-server0 \
    \
    # X11 libraries (for xcb mode)
    libx11-6 \
    libxcb1 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xkb1 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libsm6 \
    libice6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxcursor1 \
    libxss1 \
    libxcomposite1 \
    libxdamage1 \
    libxtst6 \
    \
    # System utilities
    libdbus-1-3 \
    libfontconfig1 \
    libfreetype6 \
    libglib2.0-0t64 \
    libpng16-16t64 \
    libsqlite3-0 \
    libssl3t64 \
    \
    # ICU (internationalization)
    libicu74 \
    \
    # GDB 调试工具
    gdb \
    \
    # GStreamer 支持（Qt Multimedia 后端）
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    libgstreamer-plugins-good1.0-0 \
    libgstreamer-plugins-bad1.0-0 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    gstreamer1.0-tools \
    \
    # Hardware acceleration libraries
    libgomp1 \
    \
    # 中文字体和 Emoji 支持
    fonts-noto-color-emoji \
    fonts-noto-core \
    fonts-noto-mono \
    fonts-noto-cjk \
    fonts-noto-cjk-extra \
    fonts-dejavu-core \
    fonts-arphic-ukai \
    fonts-arphic-uming \
    fonts-wqy-zenhei \
    fonts-ubuntu \
    fontconfig \
    \
    # Python 和编译工具（TTS 引擎需要）
    build-essential \
    cmake \
    swig \
    libffi-dev \
    libopencc-dev \
    python3 \
    python3-pip \
    python3-dev \
    git \
    libmecab-dev \
    mecab \
    mecab-ipadic-utf8 \
    \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -fv

# This is the system layer, no pip install here
# Python packages will be installed in the next layer
