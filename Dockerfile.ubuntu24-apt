# ==============================================================================
# Belt Control System - Ubuntu 24.04 Application Layer
# Uses base image with pre-installed dependencies
# This layer changes frequently (application updates)
# ==============================================================================

FROM --platform=linux/arm64 belt-control-base:ubuntu24

# Copy application files
WORKDIR /app

COPY belt_control_system /app/belt_control_system
COPY sherpa_tts_service /app/sherpa_tts_service
COPY lib /app/lib
COPY plugins /app/plugins
COPY qml /app/qml
COPY tts_models /app/tts_models
# ✅ 2026-01-08 14:10 [修复 81] GDB 调试包装脚本（暂时禁用）
# 注意：Docker构建上下文问题，如需调试可以手动运行：
#   docker exec -it belt-control-latest gdb /app/belt_control_system
# COPY docker/rk3588/gdb-wrapper.sh /app/gdb-wrapper.sh

# NOTE: Hardware-accelerated FFmpeg libraries are copied by build-ubuntu24-apt.ps1
# into the lib/ directory before Docker build, so they're included in the above COPY lib command

# Setup application
# ✅ 2026-01-08 17:50 [优化] GDB 已移至基础镜像，此处不再安装
# 原因：基础镜像只构建一次，应用层频繁重建
# 效果：每次编译节省 apt-get update 和 GDB 安装时间（约 30-60 秒）
# ✅ 2026-01-09 17:10 [修复 96.2] 删除 FFmpeg 插件，强制使用 GStreamer
# 问题：QT_MULTIMEDIA_PREFERRED_PLUGINS 环境变量无效，Qt 仍尝试加载 FFmpeg 插件
# 根因：Qt 6.5.3 可能不支持该环境变量，插件加载顺序固定
# 策略：删除 libffmpegmediaplugin.so，Qt 只能加载 GStreamer（唯一可用插件）
# 效果：Qt Multimedia 直接加载 GStreamer 后端，100% 成功率
RUN chmod +x /app/belt_control_system /app/sherpa_tts_service && \
    rm -f /app/plugins/multimedia/libffmpegmediaplugin.so && \
    \
    # Create symlinks for application libraries (Qt6, FFmpeg, custom libs)
    cd /app/lib && \
    for lib in libavcodec libavformat libavutil libavdevice libavfilter libavresample libswresample libswscale \
               libopus libmp3lame libogg libvorbis libvorbisenc libvorbisfile libtheora libtheoradec libtheoraenc libspeex libvo-amrwbenc libyuv \
               libvpx libx264 libx265 libwebp libwebpmux libwebpdemux \
               libaribb24 libaom libcodec2 libgsm libopencore-amrnb libopencore-amrwb libopenjp2 libshine libsnappy libtwolame libwavpack libxvidcore libzvbi \
               libva libva-drm libva-x11 libva-wayland libvdpau libOpenCL libsoxr \
               librockchip_mpp libdav1d \
               libsherpa-onnx-c-api libsherpa-onnx libonnxruntime libmali libicui18n libicuuc libpcre2-16 librknnrt libxcb-dri2 libssl libcrypto; do \
        if ls ${lib}.so.* 1> /dev/null 2>&1; then \
            # ✅ 2026-01-01: Exclude backup files (*.backup-*) when selecting latest library version
            latest=$(ls -v ${lib}.so.* 2>/dev/null | grep -v '\.backup-' | tail -1); \
            [ -z "$latest" ] && continue; \
            basename_file=$(basename "$latest"); \
            version=$(echo "$basename_file" | sed "s/${lib}.so.//"); \
            major=$(echo "$version" | cut -d. -f1); \
            [ -n "$major" ] && ln -sf "$basename_file" "${lib}.so.${major}" 2>/dev/null || true; \
            ln -sf "$basename_file" "${lib}.so" 2>/dev/null || true; \
        fi; \
    done && \
    \
    # Special case: libopenjp2 package version (7) != library version (2.3.1)
    [ -f /app/lib/libopenjp2.so.2.3.1 ] && ln -sf libopenjp2.so.2.3.1 /app/lib/libopenjp2.so.7 && \
    \
    # Configure fontconfig for emoji support
    mkdir -p /etc/fonts/conf.d && \
    echo '<?xml version="1.0"?>' > /etc/fonts/conf.d/01-emoji.conf && \
    echo '<!DOCTYPE fontconfig SYSTEM "fonts.dtd">' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '<fontconfig>' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '  <!-- Prepend Noto Color Emoji for emoji characters -->' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '  <match>' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '    <test name="family"><string>sans-serif</string></test>' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '    <edit name="family" mode="prepend" binding="strong">' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '      <string>Noto Color Emoji</string>' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '    </edit>' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '  </match>' >> /etc/fonts/conf.d/01-emoji.conf && \
    echo '</fontconfig>' >> /etc/fonts/conf.d/01-emoji.conf && \
    \
    # Rebuild font cache to ensure emoji fonts are properly registered
    fc-cache -f -v || true

# Environment variables
# ✅ Note: QT_QPA_PLATFORM is NOT set in Dockerfile
# It will be set by run script based on DISPLAY environment:
# - If X11 available (ssh -X) → use xcb (windowed)
# - If no X11 (direct run) → use eglfs (fullscreen)
# ✅ 2026-01-09 17:00 [修复 96.1] 显式指定 Qt Multimedia 使用 GStreamer 后端
# 问题：GStreamer 库已安装，但 Qt 仍尝试加载 FFmpeg 插件（失败）
# 根因：Qt Multimedia 默认按顺序尝试插件，FFmpeg 失败后未尝试 GStreamer
# 策略：设置 QT_MULTIMEDIA_PREFERRED_PLUGINS=gstreamer 强制使用 GStreamer
# 效果：Qt Multimedia 直接加载 GStreamer 后端，videoFrameChanged 信号正常触发
ENV LD_LIBRARY_PATH=/app/lib:/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu:$LD_LIBRARY_PATH \
    QT_PLUGIN_PATH=/app/plugins \
    QML2_IMPORT_PATH=/app/qml \
    QT_QPA_EGLFS_INTEGRATION=eglfs_kms \
    QT_QPA_EGLFS_ALWAYS_SET_MODE=1 \
    QT_MULTIMEDIA_PREFERRED_PLUGINS=gstreamer

WORKDIR /app

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD test -f /app/belt_control_system || exit 1

# ✅ 2026-01-08 14:20 [修复 81] 正常启动（GDB包装脚本已禁用）
# 如需调试，运行：docker exec -it belt-control-latest gdb /app/belt_control_system
CMD ["/app/belt_control_system"]
