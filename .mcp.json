{
  "mcpServers": {
    "mcp-memory-service": {
      "type": "http",
      "url": "http://127.0.0.1:8888/mcp"
    },
    "excel": {
      "command": "cmd",
      "args": ["/c", "npx", "--yes", "@negokaz/excel-mcp-server"],
      "env": {
        "EXCEL_MCP_PAGING_CELLS_LIMIT": "4000"
      }
    }
  }
}
