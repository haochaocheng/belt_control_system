# ==============================================================================
# Belt Control System - Ubuntu 24.04 Base Image
# This is the BASE layer containing only system dependencies
# It rarely changes, so it will be cached by Docker
# ==============================================================================

FROM --platform=linux/arm64 ubuntu:24.04

# Avoid interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# ============================================================
# Install ALL system dependencies via apt-get
# This layer is CACHED and will NOT be rebuilt unless changed
# ============================================================
RUN apt-get update && apt-get install -y \
    # Core libraries
    libc6 \
    libstdc++6 \
    libgcc-s1 \
    \
    # Audio and multimedia
    libasound2t64 \
    libopus0 \
    libsdl2-2.0-0 \
    \
    # Video/Audio codecs (FFmpeg dependencies from device)
    # These are required by the factory-installed FFmpeg with RKMPP support
    libvpx9 \
    libx264-164 \
    libx265-199 \
    libmp3lame0 \
    libspeex1 \
    libtheora0 \
    libvorbis0a \
    libvorbisenc2 \
    libogg0 \
    libyuv0 \
    \
    # Video4Linux
    libv4l-0t64 \
    \
    # OpenGL/EGL/Graphics
    libegl1 \
    libgles2 \
    libgbm1 \
    libdrm2 \
    libwayland-client0 \
    libwayland-egl1 \
    \
    # X11 libraries (for xcb mode)
    libx11-6 \
    libxcb1 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xkb1 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libsm6 \
    libice6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxcursor1 \
    libxss1 \
    libxcomposite1 \
    libxdamage1 \
    libxtst6 \
    \
    # System utilities
    libdbus-1-3 \
    libfontconfig1 \
    libfreetype6 \
    libglib2.0-0t64 \
    libpng16-16t64 \
    libsqlite3-0 \
    libssl3t64 \
    \
    # ICU (internationalization)
    libicu74 \
    \
    # ✅ 2026-01-08 17:50 [优化] GDB 调试工具（移至基础镜像，避免每次重新安装）
    # 原因：应用层镜像频繁重建，基础镜像只构建一次
    # 效果：节省每次编译时 apt-get update 和 GDB 安装时间
    gdb \
    \
    # ✅ 2026-01-09 15:25 [修复 96] GStreamer 支持（Qt Multimedia 后端）
    # 问题：Qt Multimedia 插件存在但无法加载，启动日志显示 "could not load multimedia backend"
    # 根因 1: FFmpeg 插件需要 FFmpeg 4.x，容器使用 FFmpeg 6.x（版本不匹配）
    # 根因 2: GStreamer 插件缺少 GStreamer 库（完全未安装）
    # 策略：安装 GStreamer 1.0 库，使用 GStreamer 后端
    # 效果：VideoSinkItem 可以正常接收和渲染视频帧，解决 Linux 设备视频显示黑屏问题
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    libgstreamer-plugins-good1.0-0 \
    libgstreamer-plugins-bad1.0-0 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    gstreamer1.0-tools \
    \
    # Hardware acceleration libraries (attempt to install from system)
    # ✅ 2026-01-07: Try system packages first, fallback to host mount if unavailable
    libgomp1 \
    \
    # Emoji and symbol fonts (FIX for emoji display in QML)
    # 2026-01-17 17:30 [FIX 100.244] 添加 fontconfig 和字体缓存刷新
    # 2026-01-17 18:00 [FIX 100.244 方案B] 添加中文字体支持，移除宿主机字体挂载
    # 问题：原方案通过挂载宿主机字体目录实现中文显示，不符合容器化理念
    # 方案B：在容器内安装与宿主机相同的字体包，实现自包含部署
    # 中文字体：arphic-ukai（楷体）, arphic-uming（明体）, wqy-zenhei（黑体）, noto-cjk（全字重）
    fonts-noto-color-emoji \
    fonts-noto-core \
    fonts-noto-mono \
    fonts-noto-cjk \
    fonts-noto-cjk-extra \
    fonts-dejavu-core \
    fonts-arphic-ukai \
    fonts-arphic-uming \
    fonts-wqy-zenhei \
    fonts-ubuntu \
    fontconfig \
    \
    # ✅ 2026-02-16 02:40: 添加 Python 和 TTS 引擎依赖到基础镜像
    # 原因：PaddleSpeech 依赖安装耗时 80+ 分钟，移到基础镜像避免每次重新安装
    # 效果：基础镜像构建一次，应用层镜像每次只需 2-3 分钟
    # ✅ 2026-02-24 14:30 [Phase 7.46.44]: 添加 git（MeloTTS 从 GitHub 安装需要）
    # ✅ 2026-02-24 15:00 [Phase 7.46.46]: 添加 MeCab（MeloTTS 依赖 fugashi 需要）
    python3 \
    python3-pip \
    python3-dev \
    git \
    libmecab-dev \
    mecab \
    mecab-ipadic-utf8 \
    \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -fv

# ✅ 2026-02-16 02:40: 安装 PaddleSpeech 依赖
# 原因：PaddleSpeech 依赖安装耗时长，移到基础镜像
# 策略：先安装兼容的 numpy 版本，再安装其他依赖
# 效果：避免 numpy 2.x 导致的 AttributeError: _ARRAY_API not found
# ✅ 2026-02-22 12:35 [Phase 7.46.41]: 添加 MeloTTS 依赖，破坏缓存
# ✅ 2026-02-22 14:00 [Phase 7.46.43]: 修复 MeloTTS 安装源（从 GitHub）
# ✅ 2026-02-24 18:30 [Phase 7.46.47]: 添加 Rust 编译器（tokenizers 需要）
# 原因：tokenizers 包需要 Rust 编译器，否则 pip install 失败，浪费 83 分钟
# 效果：可以从源码编译 tokenizers，避免构建失败
# 方案：先安装 Rust，再安装 Python 依赖
RUN apt-get update && apt-get install -y curl \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && rm -rf /var/lib/apt/lists/*

# 设置 Rust 环境变量
ENV PATH="/root/.cargo/bin:${PATH}"

COPY docker/rk3588/tts_engines/paddlespeech/requirements.txt /tmp/paddlespeech-requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages \
    "numpy<2.0.0" \
    && pip3 install --no-cache-dir --break-system-packages \
    -r /tmp/paddlespeech-requirements.txt \
    && rm /tmp/paddlespeech-requirements.txt

# Create application directory structure
RUN mkdir -p /app/lib /app/plugins /app/qml /app/data /app/config /app/tts_models /app/AUDIO

WORKDIR /app

# This is a base image, no CMD needed
# Application layer will add CMD
