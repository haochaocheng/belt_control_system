# ==============================================================================
# Belt Control System - Ubuntu 24.04 Base Image
# This is the BASE layer containing only system dependencies
# It rarely changes, so it will be cached by Docker
# ==============================================================================

FROM --platform=linux/arm64 ubuntu:24.04

# Avoid interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# ============================================================
# Install ALL system dependencies via apt-get
# This layer is CACHED and will NOT be rebuilt unless changed
# ============================================================
RUN apt-get update && apt-get install -y \
    # Core libraries
    libc6 \
    libstdc++6 \
    libgcc-s1 \
    \
    # Audio and multimedia
    libasound2t64 \
    libopus0 \
    libsdl2-2.0-0 \
    \
    # Video4Linux
    libv4l-0t64 \
    \
    # OpenGL/EGL/Graphics
    libegl1 \
    libgles2 \
    libgbm1 \
    libdrm2 \
    libwayland-client0 \
    libwayland-egl1 \
    \
    # X11 libraries (for xcb mode)
    libx11-6 \
    libxcb1 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xkb1 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libsm6 \
    libice6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxcursor1 \
    libxss1 \
    libxcomposite1 \
    libxdamage1 \
    libxtst6 \
    \
    # System utilities
    libdbus-1-3 \
    libfontconfig1 \
    libfreetype6 \
    libglib2.0-0t64 \
    libpng16-16t64 \
    libsqlite3-0 \
    libssl3t64 \
    \
    # ICU (internationalization)
    libicu74 \
    \
    # Emoji and symbol fonts (FIX for emoji display in QML)
    fonts-noto-color-emoji \
    fonts-noto-core \
    fonts-dejavu-core \
    \
    && rm -rf /var/lib/apt/lists/*

# Create application directory structure
RUN mkdir -p /app/lib /app/plugins /app/qml /app/data /app/config /app/tts_models /app/AUDIO

WORKDIR /app

# This is a base image, no CMD needed
# Application layer will add CMD
