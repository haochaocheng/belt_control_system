# Ubuntu 24.04 ARM64交叉编译环境
# 完整的构建环境，用于编译和部署到Docker容器
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 更新APT源并安装基础工具
RUN apt-get update && apt-get install -y \
    # 基础构建工具
    build-essential \
    cmake \
    ninja-build \
    git \
    wget \
    curl \
    pkg-config \
    # ARM64交叉编译工具链
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    # Qt6依赖
    qt6-base-dev \
    qt6-base-dev-tools \
    qt6-declarative-dev \
    qt6-tools-dev \
    qt6-tools-dev-tools \
    qt6-multimedia-dev \
    qt6-quick3d-dev \
    qt6-wayland-dev \
    qml6-module-qtquick \
    qml6-module-qtquick-controls \
    qml6-module-qtquick-layouts \
    qml6-module-qtquick-window \
    qml6-module-qtquick3d \
    qml6-module-qtmultimedia \
    libqt6opengl6-dev \
    # OpenGL ES支持
    libgles2-mesa-dev \
    libegl1-mesa-dev \
    # 多媒体库
    libasound2-dev \
    libpulse-dev \
    # 网络库
    libssl-dev \
    # Python工具
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 安装ARM64架构的Qt6（用于交叉编译）
RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y \
    qt6-base-dev:arm64 \
    qt6-declarative-dev:arm64 \
    qt6-multimedia-dev:arm64 \
    qt6-quick3d-dev:arm64 \
    libssl-dev:arm64 \
    libasound2-dev:arm64 \
    libpulse-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

# 创建工作目录
RUN mkdir -p /workspace /output

# 安装Sherpa-ONNX（ARM64版本）
RUN cd /opt && \
    wget -q https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.12.9/sherpa-onnx-v1.12.9-linux-aarch64-shared.tar.bz2 && \
    tar -xf sherpa-onnx-v1.12.9-linux-aarch64-shared.tar.bz2 && \
    mv sherpa-onnx-v1.12.9-linux-aarch64-shared sherpa-onnx-arm64 && \
    rm -f sherpa-onnx-v1.12.9-linux-aarch64-shared.tar.bz2

# 创建交叉编译工具链文件
RUN cat > /opt/toolchain-arm64.cmake << 'EOF'
# ARM64交叉编译工具链
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

# 使用系统提供的交叉编译器
set(CMAKE_C_COMPILER /usr/bin/aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER /usr/bin/aarch64-linux-gnu-g++)

# Qt6配置
set(CMAKE_PREFIX_PATH "/usr/lib/aarch64-linux-gnu/cmake")
set(Qt6_DIR "/usr/lib/aarch64-linux-gnu/cmake/Qt6")

# 编译标志
set(CMAKE_C_FLAGS "-march=armv8-a")
set(CMAKE_CXX_FLAGS "-march=armv8-a")

# 库搜索路径
set(CMAKE_FIND_ROOT_PATH "/usr/aarch64-linux-gnu;/usr/lib/aarch64-linux-gnu")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
EOF

# 创建构建脚本
RUN cat > /opt/build.sh << 'EOF'
#!/bin/bash
set -e

echo "=========================================="
echo "Ubuntu 24.04 ARM64 Cross Compilation"
echo "=========================================="

cd /workspace

# 清理旧的构建
rm -rf build
mkdir -p build
cd build

# 配置CMake
echo "配置项目..."
cmake -G Ninja \
    -DCMAKE_TOOLCHAIN_FILE=/opt/toolchain-arm64.cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_SHERPA_ONNX=ON \
    -DSHERPA_ONNX_DIR=/opt/sherpa-onnx-arm64 \
    ..

# 编译
echo "开始编译..."
ninja -j$(nproc)

# 复制输出文件
echo "复制输出文件..."
cp belt_control_system /output/ 2>/dev/null || true
cp -r ../config /output/ 2>/dev/null || true
cp -r ../libs/tts_models /output/ 2>/dev/null || true

echo "=========================================="
echo "✓ 编译完成！"
echo "输出目录: /output"
echo "=========================================="

ls -lh /output/
EOF

RUN chmod +x /opt/build.sh

WORKDIR /workspace
CMD ["/opt/build.sh"]