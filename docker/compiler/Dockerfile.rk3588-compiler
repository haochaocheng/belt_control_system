# RK3588交叉编译环境 - 基于Ubuntu 22.04 (GLIBC 2.35)
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 安装基础构建工具
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    wget \
    curl \
    pkg-config \
    python3 \
    python3-pip \
    # 交叉编译工具链
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    # Qt6依赖的主机工具
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libx11-dev \
    libx11-xcb-dev \
    libxext-dev \
    libxfixes-dev \
    libxi-dev \
    libxrender-dev \
    libxcb1-dev \
    libxcb-glx0-dev \
    libxcb-keysyms1-dev \
    libxcb-image0-dev \
    libxcb-shm0-dev \
    libxcb-icccm4-dev \
    libxcb-sync-dev \
    libxcb-xfixes0-dev \
    libxcb-shape0-dev \
    libxcb-randr0-dev \
    libxcb-render-util0-dev \
    libxcb-util-dev \
    libxcb-xinerama0-dev \
    libxcb-xkb-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    # ICU库（Ubuntu 22.04提供ICU 70）
    libicu-dev \
    libicu70 \
    # 其他依赖
    libssl-dev \
    libdbus-1-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libjpeg-dev \
    libsqlite3-dev \
    # 音频库
    libasound2-dev \
    libpulse-dev \
    # 清理
    && rm -rf /var/lib/apt/lists/*

# 设置交叉编译环境变量
ENV CC=aarch64-linux-gnu-gcc
ENV CXX=aarch64-linux-gnu-g++
ENV AR=aarch64-linux-gnu-ar
ENV STRIP=aarch64-linux-gnu-strip
ENV CMAKE_TOOLCHAIN_FILE=/opt/qt-raspi/lib/cmake/Qt6/qt.toolchain.cmake
ENV QT_HOST_PATH=/opt/qt-host
ENV QT_TARGET_PATH=/opt/qt-raspi
ENV SYSROOT=/opt/sysroot/pi-root

# 创建兼容性符号链接（为ICU 74创建ICU 70的链接）
RUN mkdir -p /usr/lib/x86_64-linux-gnu && \
    if [ -f /usr/lib/x86_64-linux-gnu/libicuuc.so.70 ]; then \
        ln -sf libicuuc.so.70 /usr/lib/x86_64-linux-gnu/libicuuc.so.74; \
        ln -sf libicui18n.so.70 /usr/lib/x86_64-linux-gnu/libicui18n.so.74; \
        ln -sf libicudata.so.70 /usr/lib/x86_64-linux-gnu/libicudata.so.74; \
    fi

# 设置工作目录
WORKDIR /workspace

# 入口点
CMD ["/bin/bash"]