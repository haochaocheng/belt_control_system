# 预构建基础镜像 - 包含所有系统运行时库
# 这个镜像可以直接传输到工控机使用,无需任何网络下载

FROM --platform=linux/arm64 arm64v8/debian:trixie

# 安装所有运行时依赖(一次性,打包进基础镜像)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenGL/EGL
    libgles2 \
    libegl1 \
    libgl1 \
    # 音频
    libpulse0 \
    libpulse-mainloop-glib0 \
    # X11/Wayland
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libxcb-sync1 \
    libxcb-xkb1 \
    libxcb-cursor0 \
    libxcb-dri2-0 \
    # 字体和文本渲染
    libfontconfig1 \
    libfreetype6 \
    # D-Bus
    libdbus-1-3 \
    # X11基础
    libx11-6 \
    libx11-xcb1 \
    libsm6 \
    libice6 \
    # 输入设备 (Qt插件依赖)
    libmtdev1 \
    libts0 \
    libinput10 \
    # 其他常用库
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 元数据
LABEL maintainer="Belt Control System"
LABEL description="Pre-built base image with runtime dependencies for RK3588"
LABEL version="1.2"
