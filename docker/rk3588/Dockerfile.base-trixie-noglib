# Debian Trixie基础镜像 - 满足GLIBC 2.38需求,但不安装GLib
# Qt6环境将使用打包的GLib库

FROM --platform=linux/arm64 arm64v8/debian:trixie

# 安装所有运行时依赖,但排除libglib2.0-0
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenGL/EGL
    libgles2 \
    libegl1 \
    libgl1 \
    # 音频
    libpulse0 \
    libpulse-mainloop-glib0 \
    # X11/Wayland
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libxcb-sync1 \
    libxcb-xkb1 \
    libxcb-cursor0 \
    libxcb-dri2-0 \
    # 字体和文本渲染
    libfontconfig1 \
    libfreetype6 \
    # D-Bus
    libdbus-1-3 \
    # X11基础
    libx11-6 \
    libx11-xcb1 \
    libsm6 \
    libice6 \
    # 输入设备 (Qt插件依赖)
    libmtdev1 \
    libts0 \
    libinput10 \
    # 注意:不安装 libglib2.0-0,使用打包的版本
    # 其他常用库
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 元数据
LABEL maintainer="Belt Control System"
LABEL description="Debian Trixie base without GLib - use bundled GLib from lib directory"
LABEL version="3.0"
LABEL glibc_version="2.41"
