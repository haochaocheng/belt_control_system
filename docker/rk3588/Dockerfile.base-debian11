# 基于Debian 11 (Bullseye)的基础镜像 - 匹配Qt6编译环境
# Debian 11是Qt6交叉编译的环境，GLib版本应该匹配

FROM --platform=linux/arm64 arm64v8/debian:bullseye

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 安装所有运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenGL/EGL
    libgles2 \
    libegl1 \
    libgl1 \
    # 音频
    libpulse0 \
    libpulse-mainloop-glib0 \
    # X11/Wayland
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libxcb-sync1 \
    libxcb-xkb1 \
    libxcb-cursor0 \
    libxcb-dri2-0 \
    # 字体和文本渲染
    libfontconfig1 \
    libfreetype6 \
    # D-Bus
    libdbus-1-3 \
    # X11基础
    libx11-6 \
    libx11-xcb1 \
    libsm6 \
    libice6 \
    # 输入设备 (Qt插件依赖)
    libmtdev1 \
    libts0 \
    libinput10 \
    # GLib (已包含GObject)
    libglib2.0-0 \
    # 其他常用库
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 元数据
LABEL maintainer="Belt Control System"
LABEL description="Debian 11 Bullseye base image matching Qt6 build environment"
LABEL version="2.0"
LABEL base_os="Debian 11 Bullseye"
