# RK3588 Belt Control System - 完整运行时镜像
# 包含 Qt6 + 系统库 + 应用程序

FROM debian:bookworm-slim

# 安装系统运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpulse0 \
    libgles2 \
    libegl1 \
    libgl1 \
    libxkbcommon0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libxcb-sync1 \
    libdbus-1-3 \
    libfontconfig1 \
    libfreetype6 \
    libx11-6 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 创建应用程序目录
WORKDIR /app

# 复制应用程序二进制文件
COPY belt_control_system /app/

# 复制系统库 (FFmpeg, SDL2, 系统依赖)
COPY libs /app/libs

# 复制 Qt6 运行时库
COPY qt6/lib /opt/qt6/lib

# 复制 Qt6 插件
COPY qt6/plugins /opt/qt6/plugins

# 复制 Qt6 QML模块
COPY qt6/qml /opt/qt6/qml

# 设置环境变量
ENV LD_LIBRARY_PATH=/app/libs:/opt/qt6/lib:$LD_LIBRARY_PATH
ENV QT_PLUGIN_PATH=/opt/qt6/plugins
ENV QML2_IMPORT_PATH=/opt/qt6/qml
ENV QT_QPA_PLATFORM=eglfs
ENV QT_QPA_EGLFS_INTEGRATION=eglfs_kms

# 设置可执行权限
RUN chmod +x /app/belt_control_system

# 创建配置和数据目录
RUN mkdir -p /app/config /app/data

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD pgrep -f belt_control_system || exit 1

# 启动应用程序
CMD ["/app/belt_control_system"]
