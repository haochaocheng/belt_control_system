# Simple Runtime Dockerfile for RK3588 - Build on Device
FROM debian:bookworm-slim

# Set environment
ENV DEBIAN_FRONTEND=noninteractive \
    QT_QPA_PLATFORM=eglfs \
    QT_QPA_EGLFS_ALWAYS_SET_MODE=1 \
    LD_LIBRARY_PATH=/opt/app/lib:/usr/local/lib:/usr/lib/aarch64-linux-gnu \
    LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libc6 libstdc++6 libgcc-s1 \
    libx11-6 libxcb1 libxkbcommon0 libinput10 \
    libegl1 libgles2 libdrm2 libgbm1 \
    libfreetype6 libfontconfig1 libharfbuzz0b \
    libglib2.0-0 libdbus-1-3 libicu72 \
    libpulse0 libasound2 libsndfile1 \
    libv4l-0 libsdl2-2.0-0 libssl3 \
    fonts-noto-cjk fonts-noto-cjk-extra \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create app directories
RUN mkdir -p /opt/app/bin /opt/app/lib /opt/app/config /opt/app/data

# Copy application binary
COPY belt_control_system /opt/app/bin/

# Copy runtime libraries
COPY libs/*.so* /opt/app/lib/

# Set permissions
RUN chmod +x /opt/app/bin/belt_control_system

WORKDIR /opt/app/bin
CMD ["/opt/app/bin/belt_control_system"]
