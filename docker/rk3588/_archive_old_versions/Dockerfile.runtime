# RK3588 运行时 Docker 镜像
# 基于 Debian 11 (与工控机系统一致)
FROM arm64v8/debian:bullseye-slim

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    QT_QPA_PLATFORM=eglfs \
    QT_QPA_EGLFS_ALWAYS_SET_MODE=1 \
    LD_LIBRARY_PATH=/opt/app/lib:/usr/local/lib:/usr/lib/aarch64-linux-gnu \
    LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8

# 安装基础运行时依赖（最小化）
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 基础系统库
    libc6 \
    libstdc++6 \
    libgcc-s1 \
    # X11 和输入
    libx11-6 \
    libxcb1 \
    libxkbcommon0 \
    libinput10 \
    # 图形和 OpenGL
    libegl1 \
    libgles2 \
    libdrm2 \
    libgbm1 \
    # 字体和文本渲染
    libfreetype6 \
    libfontconfig1 \
    libharfbuzz0b \
    # GLib 和 DBus
    libglib2.0-0 \
    libdbus-1-3 \
    # 音频
    libpulse0 \
    libasound2 \
    libsndfile1 \
    # 视频
    libv4l-0 \
    libsdl2-2.0-0 \
    # 网络
    libssl1.1 \
    # ICU (国际化)
    libicu67 \
    # 字体支持
    fonts-noto-cjk \
    fonts-noto-cjk-extra \
    # 清理缓存
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 创建应用目录结构
RUN mkdir -p /opt/app/bin \
    /opt/app/lib \
    /opt/app/plugins \
    /opt/app/qml \
    /opt/app/config \
    /opt/app/data \
    /opt/app/tts_models \
    /opt/app/AUDIO

# 复制 Qt6 运行时库（从构建环境提取）
COPY --from=builder /opt/qt-raspi/lib/*.so* /opt/app/lib/
COPY --from=builder /opt/qt-raspi/plugins /opt/app/plugins/
COPY --from=builder /opt/qt-raspi/qml /opt/app/qml/

# 如果 builder 不可用，使用本地文件
# COPY ./runtime-libs/qt6/*.so* /opt/app/lib/
# COPY ./runtime-libs/qt6/plugins /opt/app/plugins/
# COPY ./runtime-libs/qt6/qml /opt/app/qml/

# 复制应用程序和依赖库
COPY ./bin_arm64/belt_control_system /opt/app/bin/
COPY ./runtime-libs/*.so* /opt/app/lib/

# 复制 TTS 模型
COPY ./tts_models /opt/app/tts_models/

# 复制音频文件
COPY ./AUDIO /opt/app/AUDIO/

# 复制配置文件示例
COPY ./config.ini.example /opt/app/config/config.ini

# 设置权限
RUN chmod +x /opt/app/bin/belt_control_system \
    && chmod -R 755 /opt/app

# 创建启动脚本
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "================================"\n\
echo "皮带控制系统 - 启动中..."\n\
echo "================================"\n\
\n\
# 检查配置文件\n\
if [ ! -f /opt/app/config/config.ini ]; then\n\
    echo "⚠️  配置文件不存在，使用默认配置"\n\
    cp /opt/app/config/config.ini.example /opt/app/config/config.ini\n\
fi\n\
\n\
# 设置工作目录\n\
cd /opt/app/bin\n\
\n\
# 显示系统信息\n\
echo "系统架构: $(uname -m)"\n\
echo "内核版本: $(uname -r)"\n\
echo "容器ID: $(hostname)"\n\
echo "================================"\n\
\n\
# 启动应用\n\
exec ./belt_control_system "$@"\n\
' > /opt/app/start.sh && chmod +x /opt/app/start.sh

# 暴露端口（如果有网络服务）
EXPOSE 8080 5060

# 工作目录
WORKDIR /opt/app/bin

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pidof belt_control_system || exit 1

# 启动命令
CMD ["/opt/app/start.sh"]
