# 基于Ubuntu 20.04的基础镜像 - 解决GLib版本兼容性问题
# Ubuntu 20.04使用GLIBC 2.31和较老的GLib，与Qt6编译环境匹配

FROM --platform=linux/arm64 arm64v8/ubuntu:20.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 安装所有运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenGL/EGL
    libgles2 \
    libegl1 \
    libgl1 \
    # 音频
    libpulse0 \
    libpulse-mainloop-glib0 \
    # X11/Wayland
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libxcb-sync1 \
    libxcb-xkb1 \
    libxcb-cursor0 \
    libxcb-dri2-0 \
    # 字体和文本渲染
    libfontconfig1 \
    libfreetype6 \
    # D-Bus
    libdbus-1-3 \
    # X11基础
    libx11-6 \
    libx11-xcb1 \
    libsm6 \
    libice6 \
    # 输入设备 (Qt插件依赖)
    libmtdev1 \
    libts0 \
    libinput10 \
    # GLib (已包含GObject)
    libglib2.0-0 \
    # 其他常用库
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 元数据
LABEL maintainer="Belt Control System"
LABEL description="Ubuntu 20.04 base image with GLib compatibility for Qt6"
LABEL version="2.0"
LABEL base_os="Ubuntu 20.04"
LABEL glibc_version="2.31"
