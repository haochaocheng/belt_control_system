                    }
                    contentItem: Text {
                        text: parent.text
                        color: "#FFFFFF"
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                    }
                    onClicked: {
                        // ✅ 2026-01-24: 关闭弹窗
                        root.visible = false
                    }
                }

                Button {
                    text: "保存"
                    width: 80
                    height: 35
                    background: Rectangle {
                        color: "#00AA00"
                        border.color: "#00FF00"
                        border.width: 1
                        radius: 4
                    }
                    contentItem: Text {
                        text: parent.text
                        color: "#FFFFFF"
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                    }
                    onClicked: {
                        // ✅ 2026-01-24: 保存参数（待实现）
                        console.log("保存参数")
                    }
                }

                Button {
                    text: "重置"
                    width: 80
                    height: 35
                    background: Rectangle {
                        color: "#AAAA00"
                        border.color: "#FFFF00"
                        border.width: 1
                        radius: 4
                    }
                    contentItem: Text {
                        text: parent.text
                        color: "#FFFFFF"
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                    }
                    onClicked: {
                        // ✅ 2026-01-24: 重置参数（待实现）
                        console.log("重置参数")
                    }
                }
            }
        }

        // ========== 左侧按钮列 ==========
        // ✅ 2026-01-24 [FIX 100.301]: 使用 Rectangle 容器，042.png 作为背景
        Rectangle {
            id: leftButtonsContainer
            anchors.left: parent.left

            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.leftMargin: 0
            anchors.topMargin: 65
            anchors.bottomMargin: 8
            width: 142
            color: "transparent"

            // ✅ 背景图片 042.png（使用 Image 作为背景）
            Image {
                id: leftButtonsBackground
                anchors.fill: parent
                anchors.rightMargin: 8
                source: "images/042.png"
                fillMode: Image.Stretch  // ✅ 2026-01-24 [FIX]: 拉伸填充整个区域
                smooth: true
                z: -1  // ✅ 确保在按钮下方
            }

            // ✅ 按钮列（在背景图片上方）
            Column {
                id: leftButtons
                anchors.fill: parent
                anchors.margins: 10
                anchors.leftMargin: 8
                anchors.rightMargin: 0
                anchors.topMargin: 13
                spacing: 10

                Repeater {
                    model: ["基本参数", "运行参数", "报警设置", "高级设置", "其他"]

                    Button {
                        width: parent.width - 20
                        height: 40
                        text: modelData

                        background: Rectangle {
                            color: root.currentCategory === index ? "#00AA00" : "#333333"
                            border.color: root.currentCategory === index ? "#00FF00" : "#666666"
                            border.width: root.currentCategory === index ? 2 : 1
                            radius: 4
                        }

                        contentItem: Text {
                            text: parent.text
                            color: "#FFFFFF"
                            horizontalAlignment: Text.AlignHCenter
                            verticalAlignment: Text.AlignVCenter
                            font.bold: root.currentCategory === index
                        }
                    }
                }
            }
        }

        // ========== 中间参数显示区域 ==========
        Rectangle {
            id: contentArea
            anchors.left: leftButtonsContainer.right  // ✅ 2026-01-24 [FIX]: 更新锚点引用
            anchors.right: parent.right
            anchors.top: topButtonsContainer.bottom
            anchors.bottom: bottomButtonsContainer.top  // ✅ 2026-01-24 [FIX]: 为底部按钮留出空间
            anchors.margins: 20
            color: "transparent"  // 透明，显示背景图片

            // 占位符文本
            Column {
                anchors.centerIn: parent
                spacing: 20

                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: "当前类别: " + getCategoryName(root.currentCategory)
                    font.pixelSize: 18
                    color: "#CCCCCC"
                }

                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: "（参数设置界面待实现）"
                    font.pixelSize: 14
                    color: "#888888"
                }
            }
        }

        // ========== 底部按钮区域 ==========
        // ✅ 2026-01-24 [FIX]: 根据左侧选择的类别动态显示不同的按钮
        Rectangle {
            id: bottomButtonsContainer
            anchors.left: leftButtonsContainer.right
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            anchors.leftMargin: 20
            anchors.rightMargin: 20
            anchors.bottomMargin: 20
            height: 60
            color: "transparent"

            // ✅ 按钮行（根据 currentCategory 动态显示）
            Row {
                id: bottomButtons
                anchors.centerIn: parent
                spacing: 20

                // ✅ 2026-01-24: 使用 Repeater 根据类别动态生成按钮
                Repeater {
                    model: getBottomButtons(root.currentCategory)

                    Button {
                        text: modelData
                        width: 100
                        height: 40
                        background: Rectangle {
                            color: "#555555"
                            border.color: "#888888"
                            border.width: 1
                            radius: 4
                        }
                        contentItem: Text {
                            text: parent.text
                            color: "#FFFFFF"
                            horizontalAlignment: Text.AlignHCenter
                            verticalAlignment: Text.AlignVCenter
                        }
                        onClicked: {
                            console.log("底部按钮点击:", modelData)
                        }
                    }
                }
            }
        }
    }

    // ========== 辅助函数 ==========
    function getCategoryName(index) {
        var names = ["基本参数", "运行参数", "报警设置", "高级设置", "其他"]
        return names[index] || "未知类别"
    }

    // ✅ 2026-01-24 [FIX]: 根据类别返回底部按钮列表
    function getBottomButtons(categoryIndex) {
        switch(categoryIndex) {
            case 0: // 基本参数
                return ["添加参数", "删除参数", "导入配置", "导出配置"]
            case 1: // 运行参数
                return ["启动", "停止", "暂停", "恢复"]
            case 2: // 报警设置
                return ["添加报警", "删除报警", "测试报警"]
            case 3: // 高级设置
                return ["系统诊断", "日志查看", "备份数据", "恢复数据"]
            case 4: // 其他
                return ["关于", "帮助"]
            default:
                return []
        }
    }
}
