import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

// ✅ 2026-01-24 [设备信息界面重构] 设备参数设置弹窗
// QDS 预览版本：使用 Rectangle 替代 Dialog
Rectangle {
    id: root
    width: 800
    height: 600
    color: "#ec1e1e1e"

    // ========== 公开属性 ==========
    property string deviceName: "1号皮带（预览）"  // 设备名称
    property int deviceId: 1                      // 设备ID
