        anchors.top: header.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        spacing: 0

        // 1号电机
        Rectangle {
            width: parent.width
            height: 60
            color: root.currentMotorIndex === 0 ? "#252b3d" : "transparent"
            border.color: root.currentMotorIndex === 0 ? "#2196F3" : "#3d4556"
            border.width: 1

            Rectangle {
                visible: root.currentMotorIndex === 0
                width: 4
                height: parent.height
                color: "#2196F3"
                anchors.left: parent.left
            }

            Column {
                anchors.left: parent.left
                anchors.leftMargin: 20
                anchors.verticalCenter: parent.verticalCenter
                spacing: 4

                Text {
                    text: "1号电机"
                    font.pixelSize: 16
                    font.weight: root.currentMotorIndex === 0 ? Font.Bold : Font.Normal
                    color: root.currentMotorIndex === 0 ? "#E0E0E0" : "#9E9E9E"
                }

                Row {
                    spacing: 8
                    Rectangle {
                        width: 8
                        height: 8
                        radius: 4
                        color: "#4CAF50"
                        anchors.verticalCenter: parent.verticalCenter
                    }
                    Text {
                        text: "运行中"
                        font.pixelSize: 12
                        color: "#9E9E9E"
                    }
                }
            }

            MouseArea {
                anchors.fill: parent
                onClicked: {
                    root.currentMotorIndex = 0
                    root.motorSelected(0)
                    root.focus = true
                }
            }
        }

