import QmlProject

// ✅ 2026-01-25 [QDS完整项目配置] 皮带控制系统 - 完整 QDS 项目
// 用途：在 QDS 中运行整个应用程序的所有页面
Project {
    // ========== 主文件配置 ==========
    mainFile: "main_qds.qml"  // QDS 专用入口（不依赖 C++ 后端）
    mainUiFile: "components/device_info/pages/MotorControlPage.qml"  // 主界面文件

    // ========== QML 文件包含 ==========
    // 主页面
    QmlFiles {
        directory: "pages"
    }

    // 组件
    QmlFiles {
        directory: "components"
    }

    // Input1 模块
    QmlFiles {
        directory: "Input1"
    }

    // 根目录 QML 文件
    QmlFiles {
        directory: "."
        filter: "*.qml"
    }

    // ========== JavaScript 文件 ==========
    JavaScriptFiles {
        directory: "."
    }

    JavaScriptFiles {
        directory: "pages"
    }

    JavaScriptFiles {
        directory: "components"
    }

    // ========== 图片资源 ==========
    ImageFiles {
        directory: "."
    }

    ImageFiles {
        directory: "pages"
    }

    ImageFiles {
        directory: "components"
    }

    ImageFiles {
        directory: "Input1/Input1Content"
    }

    // ========== 配置文件 ==========
    Files {
        filter: "*.conf"
        files: ["qtquickcontrols2.conf"]
    }

    Files {
        filter: "qmldir"
        directory: "."
    }

    Files {
        filter: "qmldir"
        directory: "components"
    }

    // ========== 字体文件 ==========
    FontFiles {
        filter: "*.ttf;*.otf"
        directory: "."
    }

    // ========== 音频文件 ==========
    Files {
        filter: "*.wav;*.mp3"
        directory: "."
    }

    // ========== 视频文件 ==========
    Files {
        filter: "*.mp4"
        directory: "."
    }

    // ========== Shader 文件 ==========
    Files {
        filter: "*.glsl;*.glslv;*.glslf;*.vsh;*.fsh;*.vert;*.frag"
        directory: "."
    }

    Files {
        filter: "*.qsb"
        directory: "."
    }

    // ========== JSON 配置文件 ==========
    Files {
        filter: "*.json"
        directory: "."
    }

    // ========== 3D 模型文件 ==========
    Files {
        filter: "*.mesh"
        directory: "."
    }

    Files {
        filter: "*.qad"
        directory: "."
    }

    // ========== 环境变量配置 ==========
    Environment {
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
        QML_COMPAT_RESOLVE_URLS_ON_ASSIGNMENT: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"

        // ✅ 调试选项（可选）
        /* Useful for debugging
        QSG_VISUALIZE: "batches"
        QSG_VISUALIZE: "clip"
        QSG_VISUALIZE: "changes"
        QSG_VISUALIZE: "overdraw"
        */
    }

    // ========== Qt 版本配置 ==========
    qt6Project: true
    qdsVersion: "4.8"
    quickVersion: "6.8"

    // ========== 导入路径 ==========
    /* QML 模块导入路径 */
    importPaths: [
        ".",
        "components",
        "pages",
        "Input1"
    ]

    // ========== 部署配置 ==========
    /* 部署目标目录 */
    targetDirectory: "/opt/BeltControlSystem"

    // ========== Widget 支持 ==========
    /* 如果项目导入需要 widgets 的模块（如 QtCharts），设置为 true */
    widgetApp: true

    // ========== Shader 工具配置 ==========
    ShaderTool {
        args: "-s --glsl \"100 es,120,150\" --hlsl 50 --msl 12"
        files: [ "**/*.vert", "**/*.frag" ]
    }

    // ========== 多语言支持 ==========
    multilanguageSupport: true
    supportedLanguages: ["zh_CN", "en"]
    primaryLanguage: "zh_CN"
}
