    width: 1920   // 默认宽度（设计尺寸 1920x1080）
    height: 1080  // 默认高度（设计尺寸 1920x1080）

    // ✅ 2026-01-23 12:30 [FIX 100.300.4] 添加 currentPageIndex 属性（与其他页面一致）
    property int currentPageIndex: 0

    // ✅ 2026-01-23 15:30 [FIX 100.300.7] 防止重复点击测试按钮
    property bool isTesting: false

    // ✅ 2026-01-23 12:30 [FIX 100.300.4] 使用 Back 组件作为背景（与前5个页面一致）
    Back {
        anchors.fill: parent
        z: 0  // 确保在最底层
        enabled: false  // 不接收鼠标事件，只作为视觉背景
